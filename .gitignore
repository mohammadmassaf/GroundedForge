.env
__pycache__/
*.pyc
*.pyo
# Holds EVERY corpus in one sqlite file - job (vault notes) and networks
# (course PDFs) included. Never committable. The demo's store lives apart, in
# chroma_demo/, which is committed on purpose: see retrieve/paths.py.
chroma_db/
data/
venv/
.venv/
*.pdf

# `chunks/*` rather than `chunks/`: git does not descend into an excluded
# DIRECTORY, so a `!chunks/demo.json` under `chunks/` would silently never
# match. Excluding the contents instead leaves the negation reachable.
#
# demo.json is public-domain RFC text and is committed so the Gradio Space,
# which has no build step, does not have to re-ingest on every cold boot.
# job.json and networks.json stay ignored.
chunks/*
!chunks/demo.json

traces/
corpus.yaml

# STAR answers are generated from the vault notes, so they quote personal
# planning material verbatim (milestone estimates, checkpoint lists) and name
# the notes in their citations. The repo is public. bullets_*.md are committed
# instead: those draw only on mealwise, which is public too.
# To ship a STAR sample, scope it to MEALWISE, not grounded-forge:
# `make-star "<a real question>" --repo mealwise`. The vault notes are tagged
# `repo: grounded-forge`, so scoping there INCLUDES them; mealwise has 55 git +
# 16 docs chunks and zero vault notes, so everything it can cite is public.
# Check the output, then force-add that one file.
star_*.md

# Saved eval reports. Run output belongs in eval/notes.md with its commit sha,
# not as a stray file whose provenance nobody can reconstruct later.
eval_*.txt
out/

# The container's corpus config: same corpora, a different `roots:` block
# (/mnt/repos, /mnt/vault). Ignored for the same reason corpus.yaml is -- it
# still spells out the vault's folder layout.
docker/corpus.docker.yaml
